# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/company_intel

# Redis
REDIS_URL=redis://redis:6379/0

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# API Keys (if needed)
SOURCE_OPENCORPORATES_API_KEY=

# Feature Flags
SOURCE_OFFENEREGISTER_ENABLED=true
SOURCE_OPENCORPORATES_ENABLED=true
SOURCE_GLEIF_ENABLED=true
SOURCE_OPENOWNERSHIP_ENABLED=true
SOURCE_OPENSANCTIONS_ENABLED=true
SOURCE_OPENLEGALDATA_ENABLED=true
SOURCE_GOVDATA_ENABLED=true
SOURCE_OSM_ENABLED=true

# Matching Thresholds
MATCHING_AUTO_MERGE_THRESHOLD=0.95
MATCHING_PROBABLE_MATCH_THRESHOLD=0.85
MATCHING_MANUAL_REVIEW_THRESHOLD=0.70

# Logging
LOG_LEVEL=INFO