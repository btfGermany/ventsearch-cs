# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database - using SQLite for local development without Docker
DATABASE_URL=sqlite:///company_intel.db

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# API Keys (if needed)
SOURCE_OPENCORPORATES_API_KEY=


# Matching Thresholds
MATCHING_AUTO_MERGE_THRESHOLD=0.95
MATCHING_PROBABLE_MATCH_THRESHOLD=0.85
MATCHING_MANUAL_REVIEW_THRESHOLD=0.70

# Logging
LOG_LEVEL=DEBUG